// ─── VIDEOS ──────────────────────────────────────────────────────────────────

model Video {
  video_id         BigInt   @id @default(autoincrement())
  title            String   @db.VarChar(150)
  description      String   @default("") @db.Text
  tags             String   @default("") @db.VarChar(255)
  category         Int      @default(1)
  video_embed_code String   @db.Text
  ads_embed_code   String   @default("") @db.Text
  status           String   @db.VarChar(10)
  featured         String   @db.VarChar(10)
  datetime         DateTime @default(now())
  seo_title        String   @default("") @db.VarChar(150)
  seo_keywords     String   @default("") @db.VarChar(255)
  seo_description  String   @default("") @db.VarChar(255)
  views            BigInt   @default(0)
  server           String   @default("youtube") @db.VarChar(15)
  thumb_url        String   @default("") @db.VarChar(150)

  @@map("videos")
}


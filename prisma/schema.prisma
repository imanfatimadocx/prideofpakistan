generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── ENUMS ───────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
}

// ─── AUTH ────────────────────────────────────────────────────────────────────

model User {
  id       String  @id @default(cuid())
  email    String  @unique
  password String?
  role     Role    @default(ADMIN)

  sessions Session[]
  accounts Account[]
}

model Account {
  id                String @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String

  user User @relation(fields: [userId], references: [id])

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id])
}

model PublicUser {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  password      String
  emailVerified Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@map("public_users")
}

// ─── HALL OF FAME ─────────────────────────────────────────────────────────────

model HallOfFame {
  id             Int     @id @default(autoincrement())
  title          String? @db.VarChar(255)
  categoryid     Int?
  description    String? @db.Text
  shortdesc      String? @db.Text
  status         Int?    @default(0)
  feature        Int?    @default(0)
  image          String? @db.VarChar(255)
  Profession     String? @db.VarChar(255)
  City           String? @db.VarChar(255)
  Country        String? @db.VarChar(255)
  Email          String? @db.VarChar(255)
  Telephone      String? @db.VarChar(255)
  Mobile         String? @db.VarChar(255)
  address        String? @db.VarChar(255)
  Interests      String? @db.VarChar(255)
  facebook       String? @db.Text
  twitter        String? @db.Text
  linkedin       String? @db.Text
  threads        String? @db.VarChar(255)
  video_intro    String? @db.Text
  edu_degree     String? @db.VarChar(255)
  edu_year       String? @db.VarChar(5)
  edu_institute  String? @db.VarChar(500)
  edu_desc       String? @db.Text
  meta_title     String? @db.VarChar(255)
  meta_desc      String? @db.VarChar(255)
  meta_keyword   String? @db.VarChar(255)
  user_id        Int     @default(0)
  d              String  @default("") @db.VarChar(255)
  m              String  @default("") @db.VarChar(255)
  y              Int     @default(0)
  cat            Int     @default(0)
  claim          Int     @default(0)
  claim_by       Int?
  claim_comments String? @db.Text
  phonenumber    String? @db.VarChar(20)
  contact_allow  Int     @default(1)
  comments_alow  Int     @default(1)
  allow_fb_page  Int     @default(0)
  thumb_img      String? @db.VarChar(200)
  org_img        String? @db.VarChar(250)

  @@map("halloffame")
}

model HallCategory {
  categoryid   Int    @id @default(autoincrement())
  categoryname String @db.VarChar(255)
  status       Int    @default(1)

  @@map("hallcategory")
}

// ─── Pakistani Businesses ─────────────────────────────────────────────────────

model BusinessCategory {
  id         Int        @id @default(autoincrement())
  name       String     @db.VarChar(255)
  status     Int        @default(1)
  businesses Business[]

  @@map("business_categories")
}

model Business {
  id                  Int               @id @default(autoincrement())
  user_id             Int               @default(0)
  busniss_id          Int               @default(0)
  category_id         Int?
  name                String            @default("") @db.VarChar(255)
  l_name              String            @default("") @db.VarChar(255)
  email               String            @default("") @db.VarChar(255)
  company_name        String            @default("") @db.VarChar(255)
  shortdesc           String            @default("") @db.VarChar(255)
  description         String            @default("") @db.Text
  company_description String            @default("") @db.Text
  country             String            @default("") @db.VarChar(255)
  city                String            @default("") @db.VarChar(255)
  address             String            @default("") @db.VarChar(255)
  phone               String            @default("") @db.VarChar(255)
  site_url            String            @default("") @db.VarChar(255)
  no_of_emplys        String            @default("") @db.VarChar(255)
  keywords            String            @default("") @db.Text
  status              Int               @default(0)
  feature             Int               @default(0)
  image               String            @default("") @db.VarChar(255)
  org_img             String            @default("") @db.VarChar(300)
  lng                 String            @default("") @db.VarChar(255)
  lat                 String            @default("") @db.VarChar(255)
  title               String            @default("") @db.VarChar(255)
  category            BusinessCategory? @relation(fields: [category_id], references: [id])

  @@map("busniss")
}

